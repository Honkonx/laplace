# Laplace — ejemplo de configuración.
# El instalador copia este archivo a `.env` y te pregunta las claves (sin mostrarlas); también puedes editarlo a mano.
# `.env` NUNCA se sube a git. TODAS las claves son opcionales: deja en blanco lo que no tengas.
# Los valores `your_...` son solo marcadores de lugar: el instalador los trata como "sin definir".

# ── Secretos propios (los genera el instalador; no los pongas tú) ─────────────────────────────
# KAIROS_AUTH_SECRET: secreto compartido app Android <-> backend (cabecera x-kairos-key). Nunca va en la web.
KAIROS_AUTH_SECRET=your_kairos_auth_secret
# WEB_JWT_SECRET: firma las sesiones de la web (mínimo 32 caracteres).
WEB_JWT_SECRET=your_web_jwt_secret_min_32_bytes
WEB_JWT_EXPIRA_HORAS=720

# ── Telegram ─────────────────────────────────────────────────────────────────────────────────
# Token del bot principal (se crea con @BotFather). Sin él el bot no arranca; la web y el agente sí.
TELEGRAM_BOT_TOKEN=your_bot_token
# Token de un SEGUNDO bot para el agente de chat (otro bot de @BotFather). Opcional.
AGENT_TELEGRAM_BOT_TOKEN=your_separate_agent_bot_token
# Tu id numérico de Telegram como administrador (varios, separados por coma). Lo ves con /mi_id en el bot.
SPORTS_ADMIN_IDS=comma,separated,user_ids_con_acceso_admin
# Un único chat_id al que llegan los avisos del sistema. Opcional.
SPORTS_ADMIN_ID=your_telegram_chat_id
# Canal donde se publican los Top Picks, y grupo de tu comunidad. Vacíos = no se publica ni se muestra nada.
TELEGRAM_CANAL_ID=
TELEGRAM_GRUPO_URL=
TELEGRAM_GRUPO_NOMBRE=Grupo de la comunidad

# ── IA (explica y contrasta; nunca calcula probabilidades) ───────────────────────────────────
# Se usa la primera de la lista de AI_ROUTING_* que responda. Con una sola clave ya funciona.
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=gpt-oss:120b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-6
AI_TEMPERATURE=0.4
AI_ROUTING_BOT=ollama_cloud,groq,gemini,openrouter,claude
AI_ROUTING_CANAL=ollama_cloud,groq,gemini,openrouter,claude
AI_ROUTING_AGENTE=ollama_cloud,groq,gemini,openrouter,claude
AI_ROUTING_LABORATORIO=ollama_cloud,groq,gemini,openrouter,claude
# Si hay al menos una clave de IA, el agente de chat la usa.
AGENT_IA_ACTIVA=true

# ── Fuentes de datos (cada una es un proveedor distinto; la clave de una no sirve en otra) ─────
# api-football: calendario y H2H (el plan gratis solo cubre algunas temporadas).
SPORTS_API_KEY=your_api_football_key
# The Odds API: cuotas del mercado (el insumo principal del pronóstico si no tienes modelo propio).
THE_ODDS_API_KEY=your_the_odds_api_key
# OddsPapi: cuotas de casas "sharp". Opcional.
ODDSPAPI_SHARP_KEY=your_oddspapi_sharp_key
# football-data.org: tablas de posiciones.
FOOTBALL_DATA_KEY=your_football_data_key
# LiveScore6 en RapidAPI: calendario del día.
LIVESCORE6_KEY=your_livescore_rapidapi_key
# BSD: predicciones externas.
BSD_API_KEY=your_bsd_api_key

# ── Servidor ─────────────────────────────────────────────────────────────────────────────────
# Orígenes que pueden llamar a la API desde un navegador (el instalador agrega los de este equipo).
CORS_ORIGINS=http://localhost:9002,http://localhost:9003
AGENT_URL=http://127.0.0.1:9100
SPORTS_BACKEND_URL=http://127.0.0.1:9001
AGENT_LOCAL_EXECUTOR=true
# Avisos a un webhook propio cuando una fuente falla (apagado por defecto).
ALERTS_ACTIVAS=false
ALERT_WEBHOOK_URL=

# ── Avanzado (descomenta solo si lo necesitas) ───────────────────────────────────────────────
# Base de datos: por defecto SQLite en backend/db/. Con una URL que no contenga "sqlite" se asume Postgres.
# DATABASE_URL=sqlite:///./backend/db/bot_deportivo.db
# Puertos del backend y del agente (la web compilada espera el agente en el 9100).
# LAPLACE_PUERTO_BACKEND=9001
# LAPLACE_PUERTO_AGENTE=9100
# Apaga el reajuste semanal automático del modelo.
# LAPLACE_REAJUSTE_AUTOMATICO=false
