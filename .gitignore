# Proyectos de terceros para auditoría de referencia (2026-09-07) — código ajeno, no versionar
# (134MB+). Auditorías reales están en docs/referencia/proyectos-externos/, sí versionadas.
/referencias/

# Copia real de backend/+pwa/ para probar en el teléfono (Termux) — 2026-09-10, orden explícita
# del usuario de incluir el .env REAL adentro (es su propio dispositivo). NUNCA debe llegar a
# git/GitHub por eso mismo — regenerable con android-test/sync.bat, no es fuente de verdad de
# nada (el código real vive en backend/ y pwa/). Ver .claude/rules/verificar-secretos-antes-de-push.md.
/android-test/

# football-data.co.uk crudo (35 MB, regenerable desde la fuente original) —
# solo se versiona el normalizado (partidos.csv.gz), equipos_alias.json y RESUMEN.md.
backend/data/datos/football-data/raw/

# Archivo local con API keys reales pegadas en texto plano — nunca versionar
apis futbol.txt

# Temporales de QA/pytest: una sola carpeta en la raiz (regenerable, nunca versionar)
.qa/
.qa-*/
.tmp_pytest_session/

# Crudos de api-football y football-data.org: licencia no abierta para redistribuir (solo se versiona lo normalizado). Regenerables desde su fuente original
backend/data/datos/api-football/raw/
backend/data/datos/football-data-org/raw/

# Instalación portable (2026-11-09): runtimes descargados y paquetes generados
runtime/
dist-portable/
