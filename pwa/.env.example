# Backend Python real (backend/api/, FastAPI). En local: http://127.0.0.1:9001 (default si se
# deja vacío, ver src/lib/api.ts — puerto 9001, ver `laplace.bat iniciar`). Mismo nombre
# de variable que frontend/.env.example — el backend real todavía usa nombres "Kairos" en su
# auth interna (`x-kairos-key`, `KAIROS_AUTH_SECRET`), excepción protegida real.
VITE_KAIROS_BACKEND_URL=
VITE_LAPLACE_AGENT_URL=http://127.0.0.1:9100
# Canal de Telegram de tu comunidad (opcional). Vacío = la PWA no muestra enlaces a Telegram.
VITE_TELEGRAM_CANAL=
