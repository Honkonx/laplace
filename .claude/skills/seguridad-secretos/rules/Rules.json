{
  "rules": [
    {
      "group": "Fingerprint",
      "rule": [
        {
          "name": "Shiro",
          "loaded": true,
          "regex": "(=deleteMe|rememberMe=)",
          "sensitive": true
        },
        {
          "name": "JSON Web Token",
          "loaded": true,
          "regex": "(eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9._-]{10,}|eyJ[A-Za-z0-9_\\/+-]{10,}\\.[A-Za-z0-9._\\/+-]{10,})",
          "sensitive": true
        },
        {
          "name": "Swagger UI",
          "loaded": true,
          "regex": "((swagger-ui.html)|(\\\"swagger\\\":)|(Swagger UI)|(swaggerUi)|(swaggerVersion))",
          "sensitive": false
        },
        {
          "name": "Ueditor",
          "loaded": true,
          "regex": "(ueditor\\.(config|all)\\.js)",
          "sensitive": false
        },
        {
          "name": "Druid",
          "loaded": true,
          "regex": "(Druid Stat Index)",
          "sensitive": false
        },
        {
          "name": "PDF.js Viewer",
          "loaded": true,
          "regex": "(pdf.worker)",
          "sensitive": false
        },
        {
          "name": "Vite DevMode",
          "loaded": true,
          "regex": "(/\\@vite/client)",
          "sensitive": true
        }
      ]
    },
    {
      "group": "Maybe Vulnerability",
      "rule": [
        {
          "name": "Java Deserialization",
          "loaded": true,
          "regex": "(javax\\.faces\\.ViewState)",
          "sensitive": false
        },
        {
          "name": "Debug Logic Parameters",
          "loaded": true,
          "regex": "((access=)|(adm=)|(admin=)|(alter=)|(cfg=)|(clone=)|(config=)|(create=)|(dbg=)|(debug=)|(delete=)|(disable=)|(edit=)|(enable=)|(exec=)|(execute=)|(grant=)|(load=)|(make=)|(modify=)|(rename=)|(reset=)|(root=)|(shell=)|(test=)|(toggl=))",
          "sensitive": false
        },
        {
          "name": "URL As A Value",
          "loaded": true,
          "regex": "(=(https?)(://|%3a%2f%2f))",
          "sensitive": false
        },
        {
          "name": "Upload Form",
          "loaded": true,
          "regex": "(type\\=\\\"file\\\")",
          "sensitive": false
        },
        {
          "name": "DoS Paramters",
          "loaded": true,
          "regex": "((size=)|(page=)|(num=)|(limit=)|(start=)|(end=)|(count=))",
          "sensitive": false
        },
        {
          "name": "Passwd File",
          "loaded": true,
          "regex": "(/root:/bin/bash)",
          "sensitive": true
        },
        {
          "name": "Win.ini File",
          "loaded": true,
          "regex": "(for 16-bit app)",
          "sensitive": true
        }
      ]
    },
    {
      "group": "Basic Information",
      "rule": [
        {
          "name": "Email",
          "loaded": true,
          "regex": "(\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,5}\\b)",
          "sensitive": false
        },
        {
          "name": "Chinese IDCard",
          "loaded": true,
          "regex": "[^0-9]((\\d{8}(0\\d|10|11|12)([0-2]\\d|30|31)\\d{3}$)|(\\d{6}(18|19|20)\\d{2}(0[1-9]|10|11|12)([0-2]\\d|30|31)\\d{3}(\\d|X|x)))[^0-9]",
          "sensitive": true
        },
        {
          "name": "Chinese Mobile Number",
          "loaded": true,
          "regex": "[^\\w]((?:(?:\\+|0{0,2})86)?1(?:(?:3[\\d])|(?:4[5-79])|(?:5[0-35-9])|(?:6[5-7])|(?:7[0-8])|(?:8[\\d])|(?:9[189]))\\d{8})[^\\w]",
          "sensitive": false
        },
        {
          "name": "Internal IP Address",
          "loaded": true,
          "regex": "[^0-9]((127\\.0\\.0\\.1)|(10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3})|(172\\.((1[6-9])|(2\\d)|(3[01]))\\.\\d{1,3}\\.\\d{1,3})|(192\\.168\\.\\d{1,3}\\.\\d{1,3}))",
          "sensitive": true
        },
        {
          "name": "MAC Address",
          "loaded": true,
          "regex": "(^([a-fA-F0-9]{2}(:[a-fA-F0-9]{2}){5})|[^a-zA-Z0-9]([a-fA-F0-9]{2}(:[a-fA-F0-9]{2}){5}))",
          "sensitive": true
        },
        {
          "name": "IP Address",
          "loaded": true,
          "regex": "[^0-9]((?:25[0-5]|2[0-4]\\d|1\\d{2}|[1-9]\\d?)\\.(?:25[0-5]|2[0-4]\\d|1\\d{2}|[1-9]\\d?)\\.(?:25[0-5]|2[0-4]\\d|[1-9]?\\d)\\.(?:25[0-5]|2[0-4]\\d|[1-9]?\\d))",
          "sensitive": false
        }
      ]
    },
    {
      "group": "Sensitive Information",
      "rule": [
        {
          "name": "Cloud Key",
          "loaded": true,
          "regex": "(((access)(|-|_)(key)(|-|_)(id|secret))|(LTAI[a-z0-9]{12,20}))",
          "sensitive": false
        },
        {
          "name": "Windows File/Dir Path",
          "loaded": true,
          "regex": "[^\\w]([a-zA-Z]:\\\\\\\\?(?:[^<>:/\\\\|?*]+\\\\\\\\?)*)([^<>:/\\\\|?*]+(?:\\.[^<>:/\\\\|?*]+)?)",
          "sensitive": true
        },
        {
          "name": "Password Field",
          "loaded": true,
          "regex": "(((|\\\\)(|'|\")(|[\\.\\w]{1,32})([p](ass|wd|asswd|assword))(|[\\.\\w]{1,32})(|\\\\)(|'|\")( |)(:|[=]{1,3}|![=]{1,2}|[\\)]{0,1}\\.val\\()( |)(|\\\\)('|\")([^'\"]+?)(|\\\\)('|\")(|,|\\)))|((|\\\\)('|\")([^'\"]+?)(|\\\\)('|\")(|\\\\)(|'|\")( |)(:|[=]{1,3}|![=]{1,2})( |)(|[\\.\\w]{1,32})([p](ass|wd|asswd|assword))(|[\\.\\w]{1,32})(|\\\\)(|'|\")))",
          "sensitive": false
        },
        {
          "name": "Username Field",
          "loaded": true,
          "regex": "(((|\\\\)(|'|\")(|[\\.\\w]{1,32})(([u](ser|name|sername))|(account)|((((create|update)((d|r)|(by|on|at)))|(creator))))(|[\\.\\w]{1,32})(|\\\\)(|'|\")( |)(:|[=]{1,3}|![=]{1,2}|[\\)]{0,1}\\.val\\()( |)(|\\\\)('|\")([^'\"]+?)(|\\\\)('|\")(|,|\\)))|((|\\\\)('|\")([^'\"]+?)(|\\\\)('|\")(|\\\\)(|'|\")( |)(:|[=]{1,3}|![=]{1,2})( |)(|[\\.\\w]{1,32})(([u](ser|name|sername))|(account)|((((create|update)((d|r)|(by|on|at)))|(creator))))(|[\\.\\w]{1,32})(|\\\\)(|'|\")))",
          "sensitive": false
        },
        {
          "name": "WeCom Key",
          "loaded": true,
          "regex": "((corp)(id|secret))",
          "sensitive": false
        },
        {
          "name": "JDBC Connection",
          "loaded": true,
          "regex": "(jdbc:[a-z:]+://[a-z0-9\\.\\-_:;=/@?,&]+)",
          "sensitive": false
        },
        {
          "name": "Authorization Header",
          "loaded": true,
          "regex": "((basic [a-z0-9=:_\\+\\/-]{5,100})|(bearer [a-z0-9_.=:_\\+\\/-]{5,100}))",
          "sensitive": false
        },
        {
          "name": "Sensitive Field",
          "loaded": true,
          "regex": "(((|\\\\)(|'|\")(|[\\.\\w]{1,32})(key|secret|token|config|auth|access|admin|ticket)(|[\\.\\w]{1,32})(|\\\\)(|'|\")( |)(:|[=]{1,3}|![=]{1,2}|[\\)]{0,1}\\.val\\()( |)(|\\\\)('|\")([^'\"]+?)(|\\\\)('|\")(|,|\\)))|((|\\\\)('|\")([^'\"]+?)(|\\\\)('|\")(|\\\\)(|'|\")( |)(:|[=]{1,3}|![=]{1,2})( |)(|[\\.\\w]{1,32})(key|secret|token|config|auth|access|admin|ticket)(|[\\.\\w]{1,32})(|\\\\)(|'|\")))",
          "sensitive": false
        },
        {
          "name": "Mobile Number Field",
          "loaded": true,
          "regex": "(((|\\\\)(|'|\")(|[\\.\\w]{1,32})(mobile|phone|sjh|shoujihao|concat)(|[\\.\\w]{1,32})(|\\\\)(|'|\")( |)(:|[=]{1,3}|![=]{1,2}|[\\)]{0,1}\\.val\\()( |)(|\\\\)('|\")([^'\"]+?)(|\\\\)('|\")(|,|\\)))|((|\\\\)('|\")([^'\"]+?)(|\\\\)('|\")(|\\\\)(|'|\")( |)(:|[=]{1,3}|![=]{1,2})( |)(|[\\.\\w]{1,32})(mobile|phone|sjh|shoujihao|concat)(|[\\.\\w]{1,32})(|\\\\)(|'|\")))",
          "sensitive": false
        },
        {
          "name": "Userinfo In Link",
          "loaded": true,
          "regex": "(?:\"|'|\\`)(((?:[a-zA-Z]{1,10}://|//)[^\"'/]{1,}\\.[a-zA-Z]{2,}[^\"']{0,})|((?:/|\\.\\./|\\./)[^\"'><,;|*()(%%$^/\\\\\\[\\]][^\"'><,;|()]{1,})|([a-zA-Z0-9_\\-/]{1,}/[a-zA-Z0-9_\\-/]{1,}\\.(?:[a-zA-Z]{1,4}|action)(?:[\\?|#][^\"|']{0,}|))|([a-zA-Z0-9_\\-/]{1,}/[a-zA-Z0-9_\\-/]{3,}(?:[\\?|#][^\"|']{0,}|))|([a-zA-Z0-9_\\-]{1,}\\.(?:\\w)(?:[\\?|#][^\"|']{0,}|)))(?:\"|'|\\`)",
          "sensitive": false
        },
        {
          "name": "User Identity",
          "loaded": true,
          "regex": "(\\b(?:(localStorage|sessionStorage)\\.(setItem|getItem)|setCookie|Cookies\\.set)\\s*\\(\\s*['\"](.+?)['\"].*?)",
          "sensitive": false
        },
        {
          "name": "Auth Field",
          "loaded": true,
          "regex": "(((|\\\\)(|'|\")(|[\\.\\w]{1,32})(authvalue)(|[\\.\\w]{1,32})(|\\\\)(|'|\")( |)(:|[=]{1,3}|![=]{1,2}|[\\)]{0,1}\\.val\\()( |)(|\\\\)('|\")([^'\"]+?)(|\\\\)('|\")(|,|\\)))|((|\\\\)('|\")([^'\"]+?)(|\\\\)('|\")(|\\\\)(|'|\")( |)(:|[=]{1,3}|![=]{1,2})( |)(|[\\.\\w]{1,32})(authvalue)(|[\\.\\w]{1,32})(|\\\\)(|'|\")))",
          "sensitive": false
        }
      ]
    },
    {
      "group": "Other",
      "rule": [
        {
          "name": "Linkfinder",
          "loaded": true,
          "regex": "(?:\"|'|\\`)(((?:[a-zA-Z]{1,10}://|//)[^\"'/]{1,}\\.[a-zA-Z]{2,}[^\"']{0,})|((?:/|\\.\\./|\\./)[^\"'><,;|*()(%%$^/\\\\\\[\\]][^\"'><,;|()]{1,})|([a-zA-Z0-9_\\-/]{1,}/[a-zA-Z0-9_\\-/]{1,}\\.(?:[a-zA-Z]{1,4}|action)(?:[\\?|#][^\"|']{0,}|))|([a-zA-Z0-9_\\-/]{1,}/[a-zA-Z0-9_\\-/]{3,}(?:[\\?|#][^\"|']{0,}|))|([a-zA-Z0-9_\\-]{1,}\\.(?:\\w)(?:[\\?|#][^\"|']{0,}|)))(?:\"|'|\\`)",
          "sensitive": true
        },
        {
          "name": "Source Map",
          "loaded": true,
          "regex": "(\\.js\\.map)",
          "sensitive": false
        },
        {
          "name": "Create Script",
          "loaded": true,
          "regex": "(\\{[^{}]+\\}\\s*\\[[^\\s]*\\]\\s*\\+\\s*\"[^\\s]*\\.js\")",
          "sensitive": false
        },
        {
          "name": "URL Schemes",
          "loaded": true,
          "regex": "(\\b(?![\\w]{0,10}?https?://)(([A-Za-z0-9-\\.]{1,20})://([-\\w+&@#/%?=~_|!:,.;]*[-\\w+&@#/%=~_|])?))",
          "sensitive": false
        },
        {
          "name": "Router Push",
          "loaded": true,
          "regex": "(\\$router\\.push)",
          "sensitive": false
        },
        {
          "name": "All URL",
          "loaded": true,
          "regex": "(https?://[-A-Za-z0-9+&@#/%?=~_|!:,.;\\u4E00-\\u9FFF]+[-A-Za-z0-9+&@#/%=~_|])",
          "sensitive": true
        },
        {
          "name": "Request URI",
          "loaded": true,
          "regex": " ((?!.*\\.js(\\?.*)?$)(.*?[^.js$])) ",
          "sensitive": false
        },
        {
          "name": "302 Location",
          "loaded": true,
          "regex": "Location: ([^\\r\\n]*)",
          "sensitive": false
        },
        {
          "name": "OSKeys",
          "loaded": true,
          "regex": "<Key>(.*?)</Key>",
          "sensitive": true
        }
      ]
    }
  ]
}
